				</v8:item>
			</title>
		</field>
		<dataSource>ДжерелоДаних1</dataSource>
		<query>SELECT
	Продажі.Period AS Період,
	Продажі.Recorder AS Документ,
	Продажі.Контрагент AS Контрагент,
	Продажі.Кількість AS Кількість,
	Продажі.Сума AS Сума
FROM
	AccumulationRegister.ПродажіКомпанії AS Продажі</query>
	</dataSet>
	<totalField>
		<dataPath>Кількість</dataPath>
		<expression>Sum(Кількість)</expression>
	</totalField>
	<totalField>
		<dataPath>Сума</dataPath>
		<expression>Sum(Сума)</expression>
	</totalField>
